<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SM Worlds Hall of Fame</title>

<script src="https://d3js.org/d3.v7.min.js"></script>

<style>

:root{
  --bg:#0f172a;
  --panel:#1e293b;
  --text:#f8fafc;
  --muted:#94a3b8;
}

body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:system-ui,sans-serif;
}

.container{
  max-width:1600px;
  margin:auto;
  padding:20px;
}

.header{
  text-align:center;
  margin-bottom:20px;
}

.dashboard{
  display:grid;
  grid-template-columns:2fr 1fr;
  gap:20px;
}

.panel{
  background:var(--panel);
  border-radius:12px;
  padding:16px;
}

.timeline-wrapper{
  overflow-x:auto;
}

#timeline{
  display:block;
  min-width:1400px;
}

.bar{
  height:24px;
  border-radius:6px;
  margin-top:4px;
  transition:all .8s ease;
}

.club-row{
  display:flex;
  justify-content:space-between;
}

.leader-row{
  margin-bottom:12px;
}

.current-card{
  padding:12px;
  border-radius:8px;
}

.stat{
  margin-top:10px;
  font-size:14px;
}

@media(max-width:900px){

  .dashboard{
    grid-template-columns:1fr;
  }

}

</style>
</head>
<body>

<div class="container">

<div class="header">
  <h1>🏆 SM Worlds Hall of Fame</h1>
  <div id="seasonDisplay">Season 10</div>
</div>

<div class="dashboard">

  <div class="panel">

    <h2>Champions Timeline</h2>

    <div class="timeline-wrapper">
      <svg id="timeline" width="1400" height="620"></svg>
    </div>

  </div>

  <div>

    <div class="panel">

      <h2>Current Champion</h2>

      <div id="championCard"></div>

      <div class="stat" id="goatClub"></div>

    </div>

    <div class="panel" style="margin-top:20px;">

      <h2>All-Time Titles</h2>

      <div id="leaderboard"></div>

    </div>

  </div>

</div>

</div>

<script>

const history = [
{season:10,club:"Chelsea",manager:"sergio calvo"},
{season:11,club:"Chelsea",manager:"sergio calvo"},
{season:12,club:"Tottenham Hotspur",manager:"Darren Lane"},
{season:13,club:"Ajax",manager:"David Caulfield"},
{season:14,club:"Ajax",manager:"David Caulfield"},
{season:15,club:"FC Porto",manager:"Jonny Caulfield"},
{season:16,club:"Chelsea",manager:"sergio calvo"},
{season:17,club:"Barcelona",manager:"Ben Ferguson"},
{season:18,club:"Manchester United",manager:"John Cameron"},
{season:19,club:"Ajax",manager:"David Caulfield"},
{season:20,club:"AS Roma",manager:"George Alleway"},
{season:21,club:"AS Roma",manager:"George Alleway"},
{season:22,club:"Ajax",manager:"David Caulfield"},
{season:23,club:"Manchester United",manager:"John Cameron"},
{season:24,club:"Manchester United",manager:"John Cameron"},
{season:25,club:"Ajax",manager:"David Caulfield"},
{season:26,club:"Chelsea",manager:"Jesús Ramírez"},
{season:27,club:"Chelsea",manager:"Jesús Ramírez"},
{season:28,club:"Manchester United",manager:"John Cameron"},
{season:29,club:"SL Benfica",manager:"Stephen Caulfield"},
{season:30,club:"Manchester United",manager:"John Cameron"},
{season:31,club:"FC Porto",manager:"Jonny Caulfield"},
{season:32,club:"SL Benfica",manager:"Stephen Caulfield"},
{season:33,club:"Ajax",manager:"David Caulfield"},
{season:34,club:"AS Roma",manager:"George Alleway"},
{season:35,club:"AS Roma",manager:"George Alleway"},
{season:36,club:"Internazionale",manager:"JP Carmier"},
{season:37,club:"AS Roma",manager:"George Alleway"},
{season:38,club:"FC Porto",manager:"Jonny Caulfield"},
{season:39,club:"Ajax",manager:"David Caulfield"},
{season:40,club:"Ajax",manager:"David Caulfield"},
{season:41,club:"SL Benfica",manager:"Stephen Caulfield"},
{season:42,club:"SL Benfica",manager:"Stephen Caulfield"},
{season:43,club:"Internazionale",manager:"JP Carmier"},
{season:44,club:"Ajax",manager:"David Caulfield"}
];

const colours = {
"Ajax":"#D2122E",
"SL Benfica":"#E30613",
"FC Porto":"#0046AD",
"AS Roma":"#8E1F1F",
"Internazionale":"#0066CC",
"Manchester United":"#DA291C",
"Chelsea":"#034694",
"Barcelona":"#A50044",
"Tottenham Hotspur":"#132257"
};

const clubs = [...new Set(history.map(h=>h.club))];

const svg = d3.select("#timeline");

const width = 1350;
const height = 560;

const x = d3.scaleLinear()
  .domain([10,44])
  .range([220,width]);

const y = d3.scalePoint()
  .domain(clubs.sort())
  .range([40,height]);

svg.selectAll(".grid")
.data(clubs)
.enter()
.append("line")
.attr("x1",220)
.attr("x2",width)
.attr("y1",d=>y(d))
.attr("y2",d=>y(d))
.attr("stroke","#334155");

svg.selectAll(".label")
.data(clubs)
.enter()
.append("text")
.attr("x",210)
.attr("y",d=>y(d)+5)
.attr("text-anchor","end")
.attr("fill","white")
.text(d=>d);

for(let s=10;s<=44;s++){

svg.append("text")
.attr("x",x(s))
.attr("y",height+30)
.attr("text-anchor","middle")
.attr("fill","#94a3b8")
.attr("font-size","11")
.text(s);

}

const winsByClub = {};

history.forEach(h=>{

 if(!winsByClub[h.club]){
    winsByClub[h.club]=[];
 }

 winsByClub[h.club].push(h);

});

Object.entries(winsByClub).forEach(([club,wins])=>{

 const line = d3.line()
 .x(d=>x(d.season))
 .y(()=>y(club));

 const path = svg.append("path")
 .datum(wins)
 .attr("fill","none")
 .attr("stroke",colours[club])
 .attr("stroke-width",5)
 .attr("opacity",0.3)
 .attr("d",line);

 const length = path.node().getTotalLength();

 path
 .attr("stroke-dasharray",length)
 .attr("stroke-dashoffset",length)
 .transition()
 .duration(history.length*900)
 .ease(d3.easeLinear)
 .attr("stroke-dashoffset",0);

});

const seasonLine = svg.append("line")
.attr("x1",x(10))
.attr("x2",x(10))
.attr("y1",20)
.attr("y2",height)
.attr("stroke","#fbbf24")
.attr("stroke-width",4);

const counts = {};

function renderLeaderboard(){

 const board = Object.entries(counts)
 .sort((a,b)=>b[1]-a[1]);

 const max = Math.max(...board.map(x=>x[1]),1);

 document.getElementById("leaderboard").innerHTML =
 board.map(([club,total])=>`
 <div class="leader-row">

   <div class="club-row">
     <span>${club}</span>
     <strong>${total}</strong>
   </div>

   <div class="bar"
   style="
   width:${(100*total/max)}%;
   background:${colours[club]};
   ">
   </div>

 </div>
 `).join("");

 const leader = board[0];

 if(leader){

 document.getElementById("goatClub").innerHTML =
 `
 <strong>👑 Current GOAT</strong><br>
 ${leader[0]}<br>
 ${leader[1]} title${leader[1]===1?'':'s'}
 `;
 }

}

function setChampion(entry){

 document.getElementById("championCard").innerHTML=
 `
 <div class="current-card"
 style="border-left:6px solid ${colours[entry.club]}">

 <strong>Season ${entry.season}</strong>

 <h3>${entry.club}</h3>

 <div>${entry.manager}</div>

 </div>
 `;

}

history.forEach((entry,index)=>{

 setTimeout(()=>{

 document.getElementById("seasonDisplay").innerText =
 `Season ${entry.season}`;

 seasonLine
 .transition()
 .duration(400)
 .attr("x1",x(entry.season))
 .attr("x2",x(entry.season));

 svg.append("circle")
 .attr("cx",x(entry.season))
 .attr("cy",y(entry.club))
 .attr("r",0)
 .attr("fill",colours[entry.club])
 .attr("stroke","white")
 .attr("stroke-width",2)
 .style("filter","drop-shadow(0 0 8px white)")
 .transition()
 .duration(500)
 .attr("r",12);

 counts[entry.club] =
 (counts[entry.club] || 0) + 1;

 renderLeaderboard();

 setChampion(entry);

 }, index * 900);

});

</script>

</body>
</html>
